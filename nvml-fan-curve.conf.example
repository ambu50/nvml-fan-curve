# Optional systemd EnvironmentFile. Copy to /etc/nvml-fan-curve.conf.
# All discovered GPUs with NVML-controllable fans are selected by default.
# To pin selection, use space-separated indexes or stable GPU UUIDs:
# GPUS="GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx GPU-yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"
# Obtain UUIDs with: nvidia-smi --query-gpu=index,uuid,name --format=csv
GPUS=all

# Step curve: temperature Celsius : fan target percent. Default is the
# tested Quadro RTX 6000 example; tune to your card's allowed fan range.
CURVE="55:40 60:50 65:60 70:72 75:85 80:100"
POLL=5
DEADBAND=4
